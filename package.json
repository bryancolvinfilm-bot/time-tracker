{
  "name": "time-tracker",
  "productName": "Time Tracker",
  "version": "0.4.4",
  "description": "A quiet, local-first home for your time.",
  "homepage": "https://github.com/bryancolvinfilm-bot/time-tracker",
  "private": true,
  "author": "Time Tracker",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/storage.cjs && node --check src/time-utils.js && node --check src/app.js && node --check scripts/portable-startup.cjs && node --check scripts/test-portable.cjs && node --check scripts/check-mac-icon.cjs && node --check scripts/release.cjs",
    "test": "npm run test:storage && npm run test:time && npm run test:release && npm run test:desktop",
    "test:storage": "node --test tests/storage.test.cjs",
    "test:time": "node --test tests/time.test.cjs",
    "test:release": "node --test tests/release.test.cjs",
    "test:desktop": "playwright test",
    "test:portable": "node scripts/test-portable.cjs",
    "test:mac": "bash scripts/test-mac.sh",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "bash scripts/prepare-mac-icon.sh && electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.timetracker.desktop",
    "productName": "Time Tracker",
    "asar": true,
    "beforeBuild": "./scripts/portable-startup.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "linux": {
      "maintainer": "Bryan Colvin <bryancolvinfilm-bot@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "src/assets/icon.png"
    }
  }
}
